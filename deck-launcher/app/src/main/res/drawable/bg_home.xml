<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#05070D"
                android:centerColor="#111D38"
                android:endColor="#070A12" />
        </shape>
    </item>
    <item android:left="-160dp" android:top="-140dp">
        <shape android:shape="oval">
            <size android:width="460dp" android:height="460dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:centerColor="#554A7CFF"
                android:endColor="#004A7CFF" />
        </shape>
    </item>
    <item android:right="-180dp" android:bottom="-120dp">
        <shape android:shape="oval">
            <size android:width="500dp" android:height="500dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:centerColor="#4A00D6FF"
                android:endColor="#0000D6FF" />
        </shape>
    </item>
    <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
        <shape>
            <corners android:radius="36dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
