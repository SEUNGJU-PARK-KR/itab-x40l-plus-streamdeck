/ {
  model = "Spreadtrum SC9863A-1H20 Board";
  compatible = [ 31B ];
  sprd,sc-id = "sp9863a 1h20 1000";
  fragment {
    target-path = "/";
    __overlay__ {
      lcds {
        lcd_nt35695_truly_mipi_fhd {
          sprd,dsi-work-mode = <0x1>;
          sprd,dsi-lane-number = <0x4>;
          sprd,dsi-color-format = "rgb888";
          sprd,phy-bit-clock = <0xf4240>;
          sprd,phy-escape-clock = <0x4e20>;
          sprd,width-mm = <0x44>;
          sprd,height-mm = <0x79>;
          sprd,esd-check-enable = <0x1>;
          sprd,esd-check-mode = <0x1>;
          sprd,esd-check-period = <0x7d0>;
          sprd,reset-on-sequence = <0x1 0x5 0x0 0x5 0x1 0x14>;
          sprd,reset-off-sequence = <0x1 0x5>;
          sprd,initial-command = [ 2977B ];
          sprd,sleep-in-command = [ 21B ];
          sprd,sleep-out-command = [ 10B ];
          phandle = <0x1b>;
          display-timings {
            native-mode = <0x1>;
            timing0 {
              clock-frequency = <0x927c000>;
              hactive = <0x438>;
              vactive = <0x780>;
              hback-porch = <0x10>;
              hfront-porch = <0xb0>;
              vback-porch = <0x20>;
              vfront-porch = <0x20>;
              hsync-len = <0xa>;
              vsync-len = <0x4>;
              phandle = <0x1>;
            };
          };
        };
        lcd_nt35532_truly_mipi_fhd {
          sprd,dsi-work-mode = <0x1>;
          sprd,dsi-lane-number = <0x4>;
          sprd,dsi-color-format = "rgb888";
          sprd,phy-bit-clock = <0xeb7f8>;
          sprd,phy-escape-clock = <0x4e20>;
          sprd,width-mm = <0x44>;
          sprd,height-mm = <0x79>;
          sprd,esd-check-enable = <0x1>;
          sprd,esd-check-mode = <0x1>;
          sprd,reset-on-sequence = <0x1 0x5 0x0 0x5 0x1 0x14>;
          sprd,reset-off-sequence = <0x1 0x5>;
          sprd,initial-command = [ 3184B ];
          sprd,sleep-in-command = [ 21B ];
          sprd,sleep-out-command = [ 10B ];
          phandle = <0x1c>;
          display-timings {
            native-mode = <0x2>;
            timing0 {
              clock-frequency = <0x927c000>;
              hactive = <0x438>;
              vactive = <0x780>;
              hback-porch = <0x10>;
              hfront-porch = <0xb0>;
              vback-porch = <0x20>;
              vfront-porch = <0x20>;
              hsync-len = <0xa>;
              vsync-len = <0x4>;
              phandle = <0x2>;
            };
          };
        };
        lcd_nt35596_boe_mipi_fhd {
          sprd,dsi-work-mode = <0x1>;
          sprd,dsi-lane-number = <0x4>;
          sprd,dsi-color-format = "rgb888";
          sprd,phy-bit-clock = <0xf4240>;
          sprd,phy-escape-clock = <0x4e20>;
          sprd,width-mm = <0x44>;
          sprd,height-mm = <0x79>;
          sprd,esd-check-enable = <0x1>;
          sprd,esd-check-mode = <0x1>;
          sprd,esd-check-period = <0x3e8>;
          sprd,reset-on-sequence = <0x1 0x5 0x0 0x5 0x1 0x5 0x0 0x5 0x1 0x14>;
          sprd,reset-off-sequence = <0x0 0x14>;
          sprd,initial-command = [ 2878B ];
          sprd,sleep-in-command = <0x130a0001 0x28137800 0x110230a 0x24f01>;
          sprd,sleep-out-command = [ 10B ];
          phandle = <0x1d>;
          display-timings {
            native-mode = <0x3>;
            timing0 {
              clock-frequency = <0x927c000>;
              hactive = <0x438>;
              vactive = <0x780>;
              hback-porch = <0x10>;
              hfront-porch = <0xb0>;
              vback-porch = <0x20>;
              vfront-porch = <0x20>;
              hsync-len = <0xa>;
              vsync-len = <0x4>;
              phandle = <0x3>;
            };
          };
        };
        lcd_dummy_mipi_hd {
