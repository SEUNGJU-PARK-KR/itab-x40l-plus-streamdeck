          sprd,initial-command = [ 10B ];
          sprd,sleep-in-command = [ 10B ];
          sprd,sleep-out-command = [ 10B ];
          phandle = <0x1e>;
          display-timings {
            native-mode = <0x4>;
            timing0 {
              clock-frequency = <0x493e000>;
              hactive = <0x2d0>;
              vactive = <0x500>;
              hback-porch = <0x3c>;
              hfront-porch = <0x50>;
              vback-porch = <0xc>;
              vfront-porch = <0x26>;
              hsync-len = <0x3c>;
              vsync-len = <0x4>;
              phandle = <0x4>;
            };
          };
        };
